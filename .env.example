# Copy to .env and replace placeholders with TWO long random secrets:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
WISHCATCHER_PLUGIN_ACCESS_TOKEN=REPLACE_ME_WITH_A_RANDOM_SECRET
WISHCATCHER_DASHBOARD_ACCESS_TOKEN=REPLACE_ME_WITH_ANOTHER_RANDOM_SECRET

# All external AI, web and MCP calls are OFF by default.
WISHCATCHER_CONTEXT_LLM_ENABLED=0
WISHCATCHER_CONTEXT_LLM_URL=http://host.docker.internal:11434/v1/chat/completions
WISHCATCHER_CONTEXT_MODEL=qwen2.5:3b-instruct
WISHCATCHER_CONTEXT_API_KEY=
WISHCATCHER_CONTEXT_ALLOW_REMOTE=0
WISHCATCHER_CONTEXT_LLM_TIMEOUT_SEC=180

WISHCATCHER_WEB_SEARCH_ENABLED=0
WISHCATCHER_BRAVE_API_KEY=
WISHCATCHER_INSTALL_MCP=false
WISHCATCHER_MCP_ENABLED=0
WISHCATCHER_MCP_ENDPOINT=
WISHCATCHER_MCP_SEARCH_TOOL=search
WISHCATCHER_MCP_READ_ONLY_TOOLS=search,search_web
WISHCATCHER_MCP_ALLOW_REMOTE=0


# Public discovery: official HN API works without a login.
# Search index requires a Brave key, explicit opt-in.
# No scraping behind logins or access controls.
WISHCATCHER_SEARCH_DISCOVERY_ENABLED=0
WISHCATCHER_RSS_APPROVED=0
WISHCATCHER_APPROVED_RSS_URL=
WISHCATCHER_IMPORTED_DATA_APPROVED=0
WISHCATCHER_IMPORT_JSONL=

# Autonomous worker is OFF until manually enabled and started.
# docker compose --profile autodiscovery up -d --build
WISHCATCHER_AUTODISCOVERY_ENABLED=0
WISHCATCHER_DISCOVERY_SOURCES=hn_ask,hn_show
WISHCATCHER_DISCOVERY_INTERVAL_SEC=21600
WISHCATCHER_DISCOVERY_PER_SOURCE=3
WISHCATCHER_DISCOVERY_MAX_CONTEXTS=20
WISHCATCHER_DISCOVERY_PERSIST_RAG=1
