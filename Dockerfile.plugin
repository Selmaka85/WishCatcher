FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv/wishcatcher
COPY requirements-plugin.txt ./
RUN pip install --no-cache-dir -r requirements-plugin.txt
COPY backend/app ./app
RUN groupadd -g 10001 wishcatcher && useradd -m -u 10001 -g 10001 wishcatcher && mkdir -p /data && chown -R 10001:10001 /data
USER 10001
EXPOSE 8000
CMD ["uvicorn", "app.plugin_app:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
